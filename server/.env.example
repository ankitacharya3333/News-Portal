// Environment Configuration for Nepal Digital News Portal
PORT=5000
NODE_ENV=development

# Database: Neon PostgreSQL connection string
# e.g.: postgresql://neondb_owner:password@ep-cool-fog-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nepal_chronicle?schema=public"

# Authentication Secrets
JWT_SECRET="nepal_chronicle_jwt_super_secret_production_key_2026_np"
JWT_EXPIRES_IN="7d"

# Resend Transactional Email Configuration
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="The Nepal Chronicle <onboarding@resend.dev>"
ADMIN_EMAIL="rmnrr333@gmail.com"

# Application URLs
FRONTEND_URL="http://localhost:5173"
BACKEND_URL="http://localhost:5000"

# External News Ingestion APIs
# GNews API key from https://gnews.io (Free tier: 100 requests/day)
